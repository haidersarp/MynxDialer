# ─────────────────────────────────────────────────────────────────────────────
# MynxDialer — environment template. Copy to .env and fill in YOUR values.
# Never commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──
DB_HOST=mysql
DB_PORT=3306
DB_USER=dialer
DB_PASS=changeme
DB_NAME=dialer
# MySQL container root/user passwords (docker-compose)
MYSQL_ROOT_PASSWORD=changeme
MYSQL_PASSWORD=changeme

# ── Auth ──
# Generate one, e.g.:  openssl rand -hex 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_CHARS_MIN
JWT_EXPIRES_IN=24h

# ── Node ──
PORT=5000
NODE_ENV=production
DIALER_INTERVAL=3000

# ── Asterisk AMI (manager) ── must match asterisk/conf/manager.conf
AMI_HOST=172.17.0.1
AMI_PORT=5038
AMI_USER=dialer
AMI_SECRET=changeme

# ── Asterisk SIP / WebRTC ──
ASTERISK_HOST=YOUR_SERVER_PUBLIC_IP
ASTERISK_WS_PORT=8089
ASTERISK_SIP_PORT=5060
# Public IP Asterisk advertises for media/signaling (WebRTC). REQUIRED in prod.
EXTERNAL_IP=YOUR_SERVER_PUBLIC_IP

# ── Frontend build-time vars (baked into the React bundles at build) ──
# STUN/TURN for browser WebRTC. A public STUN works for simple setups; run your
# own coturn for reliability behind strict NATs.
REACT_APP_STUN_URL=stun:stun.l.google.com:19302

# ── CORS allowed origins ──
ADMIN_URL=http://localhost:3000
AGENT_URL=http://localhost:3001
