# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_CHARS_MIN
JWT_EXPIRES_IN=24h

# Database
DB_HOST=mysql
DB_PORT=3306
DB_USER=dialer
DB_PASS=changeme
DB_NAME=dialer

# Asterisk AMI
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=dialer
AMI_SECRET=changeme

# Asterisk SIP/WebRTC
ASTERISK_HOST=YOUR_SERVER_IP
ASTERISK_WS_PORT=8089
ASTERISK_SIP_PORT=5060

# CORS allowed origins
ADMIN_URL=http://localhost:3000
AGENT_URL=http://localhost:3001

# Dialer engine poll interval (ms)
DIALER_INTERVAL=3000

# Call recordings path
RECORDINGS_PATH=/var/spool/asterisk/monitor
